{
  "name": "tonkeeper-web",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tonkeeper/tonkeeper-web.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@tonkeeper/twa",
    "dev:twa": "npm run dev --workspace=@tonkeeper/twa",
    "build": "npm run build --workspace=@tonkeeper/twa && cp -r apps/twa/dist ./dist",
    "build:twa": "npx turbo build:twa",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "npx turbo typecheck"
  },
  "dependencies": {
    "@tonkeeper/uikit": "*",
    "@use-gesture/react": "^10.3.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.50.0",
    "@typescript-eslint/parser": "^5.50.0",
    "eslint": "^8.33.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-i18next": "^6.0.0-2",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-mobx": "^0.0.9",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15",
    "postcss-styled-syntax": "^0.7",
    "prettier": "^2.6.2",
    "stylelint": "^16",
    "stylelint-config-standard": "^36",
    "turbo": "^2.0.4",
    "typescript": "^4.9.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "webpack": "^5.104.0",
    "webpack-cli": "^5.0.1",
    "wrangler": "^3.114.17"
  },
  "overrides": {
    "@babel/helpers": "^7.26.10",
    "@babel/runtime": "^7.26.10",
    "axios": "^1.15.0",
    "express": "^4.20.0"
  }
}
