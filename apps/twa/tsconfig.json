{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@tonkeeper/core/dist/*": ["../../packages/core/src/*"],
            "@tonkeeper/core/*": ["../../packages/core/src/*"],
            "@tonkeeper/core": ["../../packages/core/src"],
            "@tonkeeper/uikit/dist/*": ["../../packages/uikit/src/*"],
            "@tonkeeper/uikit/*": ["../../packages/uikit/src/*"],
            "@tonkeeper/uikit": ["../../packages/uikit/src"],
            "@tonkeeper/locales/*": ["../../packages/locales/*"],
            "@tonkeeper/locales": ["../../packages/locales"]
        },

        /* Bundler mode */
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",

        /* Linting */
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src"],
    "references": [{ "path": "./tsconfig.node.json" }],
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS"
        }
    }
}
